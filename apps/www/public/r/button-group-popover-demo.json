{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "files": [
    {
      "content": "import { BotIcon, ChevronDownIcon } from \"lucide-react\";\nimport { Button } from \"~/registry/ui/button\";\nimport { ButtonGroup } from \"~/registry/ui/button-group\";\nimport { Field } from \"~/registry/ui/field\";\nimport { Popover } from \"~/registry/ui/popover\";\nimport { Textarea } from \"~/registry/ui/textarea\";\n\nexport function ButtonGroupPopoverDemo() {\n  return (\n    <ButtonGroup.Root>\n      <Button variant=\"outline\">\n        <BotIcon /> Copilot\n      </Button>\n      <Popover.Root>\n        <Button aria-label=\"Open Popover\" size=\"icon\" variant=\"outline\">\n          <ChevronDownIcon />\n        </Button>\n        <Popover.Content className=\"rounded-xl text-sm\" placement=\"bottom end\">\n          <div className=\"grid gap-2\">\n            <div className=\"grid gap-1.5\">\n              <h4 className=\"font-medium leading-none\">\n                Start a new task with Copilot\n              </h4>\n              <p className=\"text-muted-foreground text-sm\">\n                Describe your task in natural language.\n              </p>\n            </div>\n            <Field.Root>\n              <Field.Label className=\"sr-only\" htmlFor=\"task\">\n                Task Description\n              </Field.Label>\n              <Textarea\n                className=\"resize-none\"\n                id=\"task\"\n                placeholder=\"I need to...\"\n              />\n              <Field.Description>\n                Copilot will open a pull request for review.\n              </Field.Description>\n            </Field.Root>\n          </div>\n        </Popover.Content>\n      </Popover.Root>\n    </ButtonGroup.Root>\n  );\n}\n",
      "path": "src/registry/examples/button-group/button-group-popover-demo.tsx",
      "type": "registry:example"
    }
  ],
  "name": "button-group-popover-demo",
  "registryDependencies": [
    "@kanpeki/button-group",
    "@kanpeki/button",
    "@kanpeki/field",
    "@kanpeki/popover",
    "@kanpeki/textarea",
    "lucide-react"
  ],
  "type": "registry:example"
}