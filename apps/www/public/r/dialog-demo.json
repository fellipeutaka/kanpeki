{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "files": [
    {
      "content": "import { Button } from \"~/registry/ui/button\";\nimport { Dialog } from \"~/registry/ui/dialog\";\nimport { Field } from \"~/registry/ui/field\";\nimport { Input } from \"~/registry/ui/input\";\nimport { TextField } from \"~/registry/ui/text-field\";\n\nexport function DialogDemo() {\n  return (\n    <Dialog.Root>\n      <Button variant=\"outline\">Edit Profile</Button>\n\n      <Dialog.Overlay>\n        <Dialog.Modal className=\"sm:max-w-106.25\">\n          <Dialog.Content>\n            <Dialog.Header>\n              <Dialog.Title>Edit profile</Dialog.Title>\n              <Dialog.Description>\n                Make changes to your profile here. Click save when you&apos;re\n                done.\n              </Dialog.Description>\n            </Dialog.Header>\n            <div className=\"grid gap-4\">\n              <Field.Root render={<TextField defaultValue=\"Pedro Duarte\" />}>\n                <Field.Label>Name</Field.Label>\n                <Input />\n              </Field.Root>\n\n              <Field.Root render={<TextField defaultValue=\"@peduarte\" />}>\n                <Field.Label>Username</Field.Label>\n                <Input />\n              </Field.Root>\n            </div>\n            <Dialog.Footer>\n              <Button slot=\"close\" variant=\"outline\">\n                Cancel\n              </Button>\n              <Button type=\"submit\">Save changes</Button>\n            </Dialog.Footer>\n\n            <Dialog.Close />\n          </Dialog.Content>\n        </Dialog.Modal>\n      </Dialog.Overlay>\n    </Dialog.Root>\n  );\n}\n",
      "path": "src/registry/examples/dialog/dialog-demo.tsx",
      "type": "registry:example"
    }
  ],
  "name": "dialog-demo",
  "registryDependencies": [
    "@kanpeki/dialog"
  ],
  "type": "registry:example"
}