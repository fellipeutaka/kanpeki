{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "textarea-demo",
  "type": "registry:example",
  "registryDependencies": [
    "@kanpeki/textarea"
  ],
  "files": [
    {
      "path": "src/registry/examples/textarea/textarea-demo.tsx",
      "content": "import { Label } from \"~/registry/ui/label/label\";\nimport { TextField } from \"~/registry/ui/text-field\";\nimport { Textarea } from \"~/registry/ui/textarea\";\n\nexport function TextareaDemo() {\n  return (\n    <div className=\"flex w-full flex-col gap-10\">\n      <Textarea placeholder=\"Type your message here.\" />\n      <Textarea aria-invalid=\"true\" placeholder=\"Type your message here.\" />\n      <TextField>\n        <Label>Label</Label>\n        <Textarea placeholder=\"Type your message here.\" rows={6} />\n      </TextField>\n      <div className=\"grid gap-3\">\n        <Label htmlFor=\"textarea-demo-message-2\">\n          With label and description\n        </Label>\n        <Textarea\n          id=\"textarea-demo-message-2\"\n          placeholder=\"Type your message here.\"\n          rows={6}\n        />\n        <div className=\"text-muted-foreground text-sm\">\n          Type your message and press enter to send.\n        </div>\n      </div>\n      <div className=\"grid gap-3\">\n        <Label htmlFor=\"textarea-demo-disabled\">Disabled</Label>\n        <Textarea\n          disabled\n          id=\"textarea-demo-disabled\"\n          placeholder=\"Type your message here.\"\n        />\n      </div>\n    </div>\n  );\n}\n",
      "type": "registry:example"
    }
  ]
}