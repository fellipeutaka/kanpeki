{
  "name": "@kanpeki/www",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.8",
  "repository": {
    "type": "git",
    "url": "https://github.com/fellipeutaka/kanpeki.git",
    "directory": "apps/www"
  },
  "browserslist": [
    "baseline newly available"
  ],
  "scripts": {
    "postinstall": "fumadocs-mdx",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "preview": "next build && next start",
    "format": "biome format --write",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "lint:doctor": "ultracite doctor",
    "type-check": "next typegen && fumadocs-mdx && tsc --noEmit",
    "registry:build": "bun run src/scripts/build-registry.ts && shadcn build && biome check --write ./public/r/*.json ./registry.json",
    "registry:validate": "bun run src/scripts/validate-registry.ts"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@fumadocs/mdx-remote": "^1.4.4",
    "@hookform/resolvers": "catalog:",
    "@internationalized/date": "catalog:",
    "@react-stately/data": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "fumadocs-core": "^16.4.10",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.562.0",
    "motion": "catalog:",
    "next": "^16.1.6",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-aria-components": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-resizable-panels": "^3.0.6",
    "recharts": "catalog:",
    "shiki": "^3.21.0",
    "sonner": "catalog:",
    "ts-morph": "^27.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kanpeki/tsconfig": "workspace:*",
    "@shikijs/transformers": "^3.21.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/hast": "^3.0.4",
    "@types/mdx": "^2.0.13",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/unist": "^3.0.3",
    "cva": "catalog:",
    "fumadocs-mdx": "^14.2.6",
    "postcss": "^8.5.6",
    "shadcn": "^3.7.0",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tailwindcss-motion": "catalog:",
    "tailwindcss-react-aria-components": "catalog:"
  }
}
