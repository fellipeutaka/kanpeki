{
  "name": "kanpeki",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/fellipeutaka/kanpeki.git"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "start": "turbo run start",
    "preview": "turbo run preview",
    "type-check": "turbo run type-check --parallel",
    "lint": "biome check",
    "clean": "rimraf **/{.next,.turbo,node_modules,dist,out} -g",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.28.1",
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@commitlint/cz-commitlint": "^19.6.1",
    "@types/node": "^22.13.8",
    "commitizen": "^4.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": ["biome check --write --no-errors-on-unmatched"],
    "*.{ts,tsx}": ["bash -c 'pnpm run type-check'"]
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  }
}
