{
	"name": "kanpeki",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.30.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/fellipeutaka/kanpeki.git"
	},
	"scripts": {
		"dev": "turbo run dev --parallel",
		"build": "turbo run build",
		"start": "turbo run start",
		"preview": "turbo run preview",
		"type-check": "turbo run type-check --parallel",
		"lint": "biome check",
		"clean": "rimraf **/{.next,.turbo,node_modules,dist,out} -g"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@changesets/changelog-github": "^0.5.1",
		"@changesets/cli": "^2.29.7",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@commitlint/cz-commitlint": "^19.8.1",
		"@types/node": "^22.18.12",
		"commitizen": "^4.3.1",
		"husky": "^9.1.7",
		"lint-staged": "^15.5.2",
		"rimraf": "^6.0.1",
		"turbo": "^2.5.8",
		"typescript": "^5.9.3"
	},
	"lint-staged": {
		"*.{js,ts,tsx}": [
			"biome check --write --no-errors-on-unmatched"
		],
		"*.{ts,tsx}": [
			"bash -c 'pnpm run type-check'"
		]
	},
	"config": {
		"commitizen": {
			"path": "@commitlint/cz-commitlint"
		}
	},
	"workspaces": {
		"packages": [
			"apps/*",
			"config/*",
			"packages/**/*"
		],
		"catalog": {
			"@hookform/resolvers": "^4.1.3",
			"@internationalized/date": "^3.10.0",
			"@radix-ui/react-scroll-area": "^1.2.10",
			"@react-stately/data": "^3.14.1",
			"@tanstack/react-form": "^1.23.7",
			"@tanstack/react-query": "^5.90.5",
			"motion": "^12.23.24",
			"next-themes": "^0.4.6",
			"react": "^19.2.0",
			"react-aria-components": "^1.13.0",
			"react-dom": "^19.2.0",
			"react-hook-form": "^7.65.0",
			"recharts": "^2.15.4",
			"sonner": "^2.0.7",
			"zod": "^4.1.12",
			"@types/react": "^19.2.2",
			"@types/react-dom": "^19.2.2",
			"cva": "1.0.0-beta.4",
			"tailwind-merge": "^3.3.1",
			"tailwindcss": "^4.1.15",
			"tailwindcss-motion": "^1.1.1",
			"tailwindcss-react-aria-components": "^2.0.1"
		}
	}
}
