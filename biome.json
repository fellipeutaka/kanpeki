{
  "$schema": "node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignore": [".next", ".source", "dist", "node_modules"]
  },
  "organizeImports": {
    "enabled": true
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git"
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "all": true,
      "nursery": {
        "useSortedClasses": {
          "fix": "safe",
          "level": "error",
          "options": {
            "functions": ["cva", "cv", "cn", "cx"]
          }
        }
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": "off"
      },
      "style": {
        "useNamingConvention": "off",
        "noImplicitBoolean": "off",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"]
          }
        }
      },
      "correctness": {
        "noNodejsModules": "off",
        "noUnusedVariables": "error",
        "noUndeclaredDependencies": "off",
        "useImportExtensions": "off",
        "noUnusedLabels": "error",
        "noUnusedImports": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedPrivateClassMembers": "error"
      },
      "suspicious": {
        "noReactSpecificProps": "off",
        "noConsole": "off"
      }
    }
  },
  "overrides": [
    {
      "include": [
        "apps/www/src/app/**/page.tsx",
        "apps/www/src/app/**/layout.tsx",
        "apps/www/src/app/**/template.tsx",
        "apps/www/src/app/**/loading.tsx",
        "apps/www/src/app/**/error.tsx",
        "apps/www/src/app/**/not-found.tsx",
        "apps/www/src/app/**/default.tsx",
        "apps/www/src/app/**/icon.tsx",
        "apps/www/src/app/**/apple-icon.tsx",
        "apps/www/src/app/**/manifest.ts",
        "apps/www/src/app/**/opengraph-image.tsx",
        "apps/www/src/app/**/twitter-image.tsx",
        "apps/www/src/app/**/robots.ts",
        "apps/www/src/app/**/sitemap.ts",

        "apps/www/src/demos/*.tsx",
        "**/*.config.ts",
        "**/*.config.js",

        "apps/storybook/.storybook/main.ts",
        "apps/storybook/.storybook/preview.ts",
        "apps/storybook/src/stories/*.stories.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "include": ["apps/**/src/components/ui/*/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noReExportAll": "off"
          }
        }
      }
    },
    {
      "include": [
        "apps/**/src/components/ui/*/index.ts",
        "apps/**/src/components/ui/*/namespace.ts",
        "apps/**/src/lib/cva.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "globals": ["React"],
    "formatter": {
      "trailingCommas": "es5"
    }
  }
}
