{
	"$schema": "https://json.schemastore.org/tsconfig",
	"display": "Next.js",
	"compilerOptions": {
		"target": "es2024",
		"lib": ["DOM", "DOM.Iterable", "ESNext", "ES2024"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "preserve",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		]
	}
}
